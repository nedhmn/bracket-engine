{
  "name": "bracket-engine",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "gate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test && pnpm build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "knip": "6.42.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.88.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.3.2"
}
