  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@repo/blossom": "workspace:*",
    "@repo/typescript": "workspace:*",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
