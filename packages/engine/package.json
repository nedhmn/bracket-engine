{
  "name": "tournament-engine",
  "version": "0.2.1",
  "description": "Single elimination, double elimination and Swiss tournaments as pure functions over plain data.",
  "homepage": "https://nedhmn.github.io/tournament-engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nedhmn/tournament-engine.git",
